diff --git a/adapter/outboundgroup/chain_mirror.go b/adapter/outboundgroup/chain_mirror.go
new file mode 100644
index 0000000..4fa75c3
--- /dev/null
+++ b/adapter/outboundgroup/chain_mirror.go
@@ -0,0 +1,72 @@
+package outboundgroup
+
+import (
+	"context"
+	"encoding/json"
+	C "github.com/metacubex/mihomo/constant"
+	P "github.com/metacubex/mihomo/constant/provider"
+)
+
+// ChainMirror resolves the source group on every connection. The prefixed
+// copies have their dialer-proxy bound to the preceding hop; source is untouched.
+type ChainMirror struct {
+	*GroupBase
+	source, direct C.Proxy
+	prefix         string
+}
+
+func NewChainMirror(option GroupCommonOption, fallback C.Proxy, providers []P.ProxyProvider, source, direct C.Proxy, prefix string) *ChainMirror {
+	return &ChainMirror{GroupBase: NewGroupBase(GroupBaseOption{Name: option.Name, Type: C.Relay, Hidden: option.Hidden, EmptyFallback: fallback, Providers: providers}), source: source, direct: direct, prefix: prefix}
+}
+
+func (m *ChainMirror) selected(metadata *C.Metadata, touch bool) C.Proxy {
+	p := m.source
+	seen := map[string]bool{}
+	for i := 0; i < 64; i++ {
+		if p == nil || seen[p.Name()] {
+			return m.EmptyFallback()
+		}
+		seen[p.Name()] = true
+		if _, group := p.Adapter().(ProxyGroup); group {
+			p = p.Unwrap(metadata, touch)
+			continue
+		}
+		switch p.Type() {
+		case C.Direct, C.Compatible:
+			return m.direct
+		case C.Reject, C.RejectDrop:
+			return m.EmptyFallback()
+		}
+		for _, copy := range m.GetProxies(touch) {
+			if copy.Name() == m.prefix+p.Name() {
+				return copy
+			}
+		}
+		return m.EmptyFallback()
+	}
+	return m.EmptyFallback()
+}
+func (m *ChainMirror) DialContext(ctx context.Context, metadata *C.Metadata) (C.Conn, error) {
+	c, err := m.selected(metadata, true).DialContext(ctx, metadata)
+	if err == nil {
+		c.AppendToChains(m)
+	}
+	return c, err
+}
+func (m *ChainMirror) ListenPacketContext(ctx context.Context, metadata *C.Metadata) (C.PacketConn, error) {
+	c, err := m.selected(metadata, true).ListenPacketContext(ctx, metadata)
+	if err == nil {
+		c.AppendToChains(m)
+	}
+	return c, err
+}
+func (m *ChainMirror) SupportUDP() bool { return m.source.SupportUDP() && m.direct.SupportUDP() }
+func (m *ChainMirror) IsL3Protocol(metadata *C.Metadata) bool {
+	return m.selected(metadata, false).IsL3Protocol(metadata)
+}
+func (m *ChainMirror) Providers() []P.ProxyProvider { return m.providers }
+func (m *ChainMirror) Proxies() []C.Proxy           { return m.GetProxies(false) }
+func (m *ChainMirror) Now() string                  { return m.source.Name() }
+func (m *ChainMirror) MarshalJSON() ([]byte, error) {
+	return json.Marshal(map[string]any{"type": m.Type().String(), "now": m.Now(), "all": []string{m.source.Name()}, "hidden": m.Hidden()})
+}
